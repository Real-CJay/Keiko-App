rules_version = '2';

// Daily Keiko — Firestore security rules.
//
// Paste this into: Firebase console -> Firestore Database -> Rules -> Publish.
//
// Everything lives under users/{uid}/, and a signed-in person can only touch
// their own subtree. Nothing else in the database is readable or writable at
// all. This is what makes it safe to ship the Firebase apiKey publicly — the
// key identifies the project, these rules decide who may do what.

service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own data: users/{uid}/days/{date} and users/{uid}/meta/settings
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
